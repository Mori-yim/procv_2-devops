# Production ProCV — copy to .env.production and NEVER commit it.
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/mori-yim/procv-devops/backend
FRONTEND_IMAGE=ghcr.io/mori-yim/procv-devops/frontend
HTTP_PORT=80
APP_ALLOWED_ORIGINS=https://cv.example.com

MYSQL_DATABASE=procv
MYSQL_USER=procv_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRATION_MS=86400000
